<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <title>{{title}}</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <div class="mobile-viewport">
    <div class="content-area">
      <div class="add-container">
        <h3>{{title}}</h3>

        <form
          action="{{#if hasDraft}}/production_types/draft/publish{{else}}/production_types/draft/next{{/if}}"
          method="POST"
          class="add-form"
        >
          <div class="media-preview-box">
            <img
              src="http://localhost:9000/production-types-media/{{draft.image_key}}"
              onerror="this.onerror=null; this.src='/img/default-image.jpg';"
              alt="Превью производства"
            >

            <label class="file-picker">
              <span class="file-picker-label">ВЫБРАТЬ ИЗОБРАЖЕНИЕ</span>
              <input type="file" accept="image/*" class="file-picker-input" name="image">
            </label>

            <video
              src="http://localhost:9000/production-types-media/{{draft.video_key}}"
              onerror="this.onerror=null; this.src='/img/default-video.mp4';"
              controls
            ></video>
            <label class="file-picker">
              <span class="file-picker-label">ВЫБРАТЬ ВИДЕО</span>
              <input type="file" accept="video/*" class="file-picker-input" name="video">
            </label>
          </div>

          <div class="form-group">
            <label>Тип производства</label>
            <input
              type="text"
              name="craft_title"
              value="{{draft.craft_title}}"
              placeholder="Например: Гончарное производство"
              required
            >
          </div>

          {{#if hasDraft}}
            <div class="form-group">
              <label>Описание</label>
              <textarea rows="4" name="description" required>{{draft.description}}</textarea>
            </div>

            <div class="form-group">
              <label>Норма выхода продукции (шт)</label>
              <input
                type="number"
                name="production_output_rate"
                value="{{#if draft.production_output_rate}}{{draft.production_output_rate}}{{/if}}"
                required
              >
            </div>

            <div class="form-group">
              <label>Количество отходов/брака (кг)</label>
              <input
                type="number"
                name="defect_waste_quantity"
                value="{{#if draft.defect_waste_quantity}}{{draft.defect_waste_quantity}}{{/if}}"
                required
              >
            </div>

            <button type="submit" class="action-btn">Опубликовать</button>
          {{else}}
            <button type="submit" class="action-btn">Далее</button>
          {{/if}}
        </form>
      </div>
    </div>
    {{> production_types_tabbar}}
  </div>
</body>
</html>