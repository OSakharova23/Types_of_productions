<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <title>{{title}}</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <div class="mobile-viewport">
    <div class="content-area">
      <form action="/production_types" method="GET" class="filter-form">
        <div class="filter-slider-box">
          <div class="filter-slider-header">
            <span class="filter-slider-label">Норма выхода:</span>
            <span class="filter-slider-value">
              {{min_rate}} - {{max_rate}} шт
            </span>
          </div>

          <div class="range-slider-wrapper">
            <div class="range-slider-track"></div>
            <input
              type="range"
              name="min_rate"
              min="{{slider_min}}"
              max="{{slider_max}}"
              step="1"
              value="{{min_rate}}"
              class="filter-slider"
              title="Минимальная норма"
            >
            <input
              type="range"
              name="max_rate"
              min="{{slider_min}}"
              max="{{slider_max}}"
              step="1"
              value="{{max_rate}}"
              class="filter-slider"
              title="Максимальная норма"
            >
          </div>

          <!-- 11 рисок: по одной на каждую подпись -->
          <div class="filter-slider-ticks" aria-hidden="true">
            <span></span><span></span><span></span><span></span><span></span>
            <span></span><span></span><span></span><span></span><span></span>
            <span></span>
          </div>

          <!-- Подписи: slider_min, 9 промежуточных, slider_max -->
          <div class="filter-slider-scale">
            <span>{{slider_min}}</span>
            {{#each scale}}
              <span>{{this}}</span>
            {{/each}}
            <span>{{slider_max}}</span>
          </div>
        </div>
        <button type="submit">НАЙТИ</button>
      </form>

      <div class="tile-grid">
        {{#each productions}}
        <div class="card-wrapper">
          <a href="/production_types/feed/{{this.production_id}}" class="card">
            <img
              src="{{#if this.image_key}}http://localhost:9000/production-types-media/{{this.image_key}}{{else}}/img/default-image.jpg{{/if}}"
              alt="{{this.craft_title}}"
              class="card-image"
            >
            <div class="card-info">
              <p class="card-title">{{this.craft_title}}</p>
              <p>Норма: {{this.production_output_rate}} шт</p>
              <p style="color: #1A1A1A; font-size: 10px;">
                <span style="color: #d62542;">❤</span> {{this.likes_count}}
              </p>
            </div>
          </a>

          <form
            action="/production_types/delete/{{this.production_id}}"
            method="POST"
            class="delete-form"
          >
            <button type="submit" class="delete-btn" title="Удалить">✕</button>
          </form>
        </div>
        {{/each}}
      </div>
    </div>
    {{> production_types_tabbar}}
  </div>
</body>
</html>